create_clock -name clk -period 12.0000 [get_ports clk]
set_clock_transition -rise 0.15 [get_clocks clk]
set_clock_transition -fall 0.15 [get_clocks clk]
set_clock_uncertainty 0.25  [get_clocks clk]
set_input_delay -max 4.0000 -clock [get_clocks clk] [all_inputs]
set_input_delay -min 0.2500 -clock [get_clocks clk] [all_inputs]
set_output_delay -max 4.0000 -clock [get_clocks clk] [all_outputs]
set_output_delay -min 0.2500 -clock [get_clocks clk] [all_outputs]
set_load -pin_load 0.033480 [all_outputs]
